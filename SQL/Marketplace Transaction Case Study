CREATE DATABASE case_study_1;

USE case_study_1;

SELECT * FROM marketplace_transactions;

SHOW TABLES ;

-- 1. Reconstruct the commercial performance bridge. 
/* Calculate monthly GMV, delivered GMV, cancelled GMV, returned GMV, discounts, refunds, seller commission,
payment fees, fulfilment costs, and contribution proxy. Compare month-over-month growth in order count,
GMV, delivered GMV, and contribution proxy. Identify months with positive GMV growth but negative
contribution growth. */

-- Step 1 : check data 
SELECT *
FROM marketplace_transactions
LIMIT 10; 

-- Step 2 : Monthly GMV Analysis
SELECT
    DATE_FORMAT(order_timestamp, '%Y-%m') AS month,
    SUM(quantity * unit_selling_price) AS gross_sales,
    SUM(discount_amount) AS total_discount,
    SUM(quantity * unit_selling_price - discount_amount) AS total_gmv
FROM marketplace_transactions
GROUP BY DATE_FORMAT(order_timestamp, '%Y-%m')
ORDER BY month;

-- Step 3: Monthly Delivered GMV
SELECT
    DATE_FORMAT(order_timestamp, '%Y-%m') AS month,
    SUM(
        CASE
            WHEN order_status = 'Delivered'
            THEN quantity * unit_selling_price - discount_amount
            ELSE 0
        END
    ) AS delivered_gmv
FROM marketplace_transactions
GROUP BY DATE_FORMAT(order_timestamp, '%Y-%m')
ORDER BY month;

-- Step 4: Cancelled GMV
SELECT
    DATE_FORMAT(order_timestamp, '%Y-%m') AS month,
    SUM(
        CASE
            WHEN order_status = 'Cancelled'
            THEN quantity * unit_selling_price - discount_amount
            ELSE 0
        END
    ) AS cancelled_gmv
FROM marketplace_transactions
GROUP BY DATE_FORMAT(order_timestamp, '%Y-%m')
ORDER BY month;

-- Step 5: Returned GMV 
SELECT
    DATE_FORMAT(order_timestamp, '%Y-%m') AS month,
    SUM(
        CASE
            WHEN order_status = 'Returned'
            THEN quantity * unit_selling_price - discount_amount
            ELSE 0
        END
    ) AS returned_gmv
FROM marketplace_transactions
GROUP BY DATE_FORMAT(order_timestamp, '%Y-%m')
ORDER BY month;

-- Step 6: Discounts
SELECT
    DATE_FORMAT(order_timestamp, '%Y-%m') AS month,
    SUM(discount_amount) AS total_discount
FROM marketplace_transactions
GROUP BY DATE_FORMAT(order_timestamp, '%Y-%m')
ORDER BY month;

-- Step 7: Refunds
SELECT
    DATE_FORMAT(order_timestamp, '%Y-%m') AS month,
    SUM(refund_amount) AS total_refunds
FROM marketplace_transactions
GROUP BY DATE_FORMAT(order_timestamp, '%Y-%m')
ORDER BY month;

-- Step 8: Seller Commission
SELECT
    DATE_FORMAT(order_timestamp, '%Y-%m') AS month,
    SUM(
        CASE
            WHEN order_status = 'Delivered'
            THEN (quantity * unit_selling_price - discount_amount)
                 * seller_commission_rate
            ELSE 0
        END
    ) AS seller_commission_proxy
FROM marketplace_transactions
GROUP BY DATE_FORMAT(order_timestamp, '%Y-%m')
ORDER BY month;

-- Step 9: Payment Fees
SELECT
    DATE_FORMAT(order_timestamp, '%Y-%m') AS month,
    SUM(payment_fee) AS total_payment_fees
FROM marketplace_transactions
GROUP BY DATE_FORMAT(order_timestamp, '%Y-%m')
ORDER BY month ASC;

-- Step 10: Fulfilment costs
SELECT
    DATE_FORMAT(order_timestamp, '%Y-%m') AS month,
    SUM(fulfilment_cost) AS total_fulfilment_cost
FROM marketplace_transactions
GROUP BY DATE_FORMAT(order_timestamp, '%Y-%m')
ORDER BY month ASC;

-- Step 11: Contribution Proxy
SELECT
    DATE_FORMAT(order_timestamp, '%Y-%m') AS month,
    SUM(
        CASE
            WHEN order_status = 'Delivered'
            THEN (quantity * unit_selling_price - discount_amount)
                 - refund_amount
                 - payment_fee
                 - fulfilment_cost
            ELSE 0
        END
    ) AS contribution_proxy
FROM marketplace_transactions
GROUP BY DATE_FORMAT(order_timestamp, '%Y-%m')
ORDER BY month ASC;

-- Step 12: Monthly Order Count
SELECT
    DATE_FORMAT(order_timestamp, '%Y-%m') AS month,
    COUNT(DISTINCT order_id) AS total_orders
FROM marketplace_transactions
GROUP BY DATE_FORMAT(order_timestamp, '%Y-%m')
ORDER BY month ASC;

-- Step 13: Month-over-Month Order Count Growth

WITH monthly_orders AS (
    SELECT
        DATE_FORMAT(order_timestamp, '%Y-%m') AS month,
        COUNT(DISTINCT order_id) AS total_orders
    FROM marketplace_transactions
    GROUP BY DATE_FORMAT(order_timestamp, '%Y-%m')
),
order_growth AS (
    SELECT
        month,
        total_orders,
        LAG(total_orders) OVER (ORDER BY month) AS previous_month_orders
    FROM monthly_orders
)
SELECT
    month,
    total_orders,
    previous_month_orders,
    total_orders - previous_month_orders AS order_count_change,
    ROUND(
        100.0 * (total_orders - previous_month_orders)
        / NULLIF(previous_month_orders, 0),
        2
    ) AS order_growth_pct
FROM order_growth
ORDER BY month ASC;

-- Step 14: Month-over-Month GMV Growth

WITH monthly_gmv AS (
    SELECT
        DATE_FORMAT(order_timestamp, '%Y-%m') AS month,
        SUM(quantity * unit_selling_price - discount_amount) AS total_gmv
    FROM marketplace_transactions
    GROUP BY DATE_FORMAT(order_timestamp, '%Y-%m')
),
gmv_growth AS (
    SELECT
        month,
        total_gmv,
        LAG(total_gmv) OVER (ORDER BY month) AS previous_month_gmv
    FROM monthly_gmv
)
SELECT
    month,
    ROUND(total_gmv, 2) AS total_gmv,
    ROUND(previous_month_gmv, 2) AS previous_month_gmv,
    ROUND(total_gmv - previous_month_gmv, 2) AS gmv_change,
    ROUND(
        100.0 * (total_gmv - previous_month_gmv)
        / NULLIF(previous_month_gmv, 0),
        2
    ) AS gmv_growth_pct
FROM gmv_growth
ORDER BY month ASC;

-- Step 15: Month-over-Month Delivered GMV Growth

WITH monthly_delivered AS (
    SELECT
        DATE_FORMAT(order_timestamp, '%Y-%m') AS month,
        SUM(
            CASE
                WHEN order_status = 'Delivered'
                THEN quantity * unit_selling_price - discount_amount
                ELSE 0
            END
        ) AS delivered_gmv
    FROM marketplace_transactions
    GROUP BY DATE_FORMAT(order_timestamp, '%Y-%m')
),
delivered_growth AS (
    SELECT
        month,
        delivered_gmv,
        LAG(delivered_gmv) OVER (ORDER BY month) AS previous_month_delivered_gmv
    FROM monthly_delivered
)
SELECT
    month,
    ROUND(delivered_gmv, 2) AS delivered_gmv,
    ROUND(previous_month_delivered_gmv, 2) AS previous_month_delivered_gmv,
    ROUND(delivered_gmv - previous_month_delivered_gmv, 2) AS gmv_change,
    ROUND(
        100.0 * (delivered_gmv - previous_month_delivered_gmv)
        / NULLIF(previous_month_delivered_gmv, 0),
        2
    ) AS delivered_gmv_growth_pct
FROM delivered_growth
ORDER BY month ASC;

-- Step 16: Month-over-Month Contribution Proxy Growth

WITH monthly_contribution AS (
    SELECT
        DATE_FORMAT(order_timestamp, '%Y-%m') AS month,
        SUM(
            CASE
                WHEN order_status = 'Delivered'
                THEN (quantity * unit_selling_price - discount_amount)
                     - refund_amount
                     - payment_fee
                     - fulfilment_cost
                ELSE 0
            END
        ) AS contribution_proxy
    FROM marketplace_transactions
    GROUP BY DATE_FORMAT(order_timestamp, '%Y-%m')
),
contribution_growth AS (
    SELECT
        month,
        contribution_proxy,
        LAG(contribution_proxy) OVER (ORDER BY month) AS previous_month_contribution
    FROM monthly_contribution
)
SELECT
    month,
    ROUND(contribution_proxy, 2) AS contribution_proxy,
    ROUND(previous_month_contribution, 2) AS previous_month_contribution,
    ROUND(contribution_proxy - previous_month_contribution, 2) AS contribution_change,
    ROUND(
        100.0 * (contribution_proxy - previous_month_contribution)
        / NULLIF(previous_month_contribution, 0),
        2
    ) AS contribution_growth_pct
FROM contribution_growth
ORDER BY month ASC;

-- Step 17: Identify Months with Positive GMV Growth but Negative Contribution Growth

WITH monthly_metrics AS (
    SELECT
        DATE_FORMAT(order_timestamp, '%Y-%m') AS month,

        SUM(quantity * unit_selling_price - discount_amount) AS total_gmv,

        SUM(
            CASE
                WHEN order_status = 'Delivered'
                THEN (quantity * unit_selling_price - discount_amount)
                     - refund_amount
                     - payment_fee
                     - fulfilment_cost
                ELSE 0
            END
        ) AS contribution_proxy

    FROM marketplace_transactions
    GROUP BY DATE_FORMAT(order_timestamp, '%Y-%m')
),
growth_metrics AS (
    SELECT
        month,
        total_gmv,
        contribution_proxy,

        100.0 * (
            total_gmv - LAG(total_gmv) OVER (ORDER BY month)
        ) / NULLIF(
            LAG(total_gmv) OVER (ORDER BY month), 0
        ) AS gmv_growth_pct,

        100.0 * (
            contribution_proxy -
            LAG(contribution_proxy) OVER (ORDER BY month)
        ) / NULLIF(
            LAG(contribution_proxy) OVER (ORDER BY month), 0
        ) AS contribution_growth_pct

    FROM monthly_metrics
)
SELECT
    month,
    ROUND(gmv_growth_pct, 2) AS gmv_growth_pct,
    ROUND(contribution_growth_pct, 2) AS contribution_growth_pct
FROM growth_metrics
WHERE gmv_growth_pct > 0
  AND contribution_growth_pct < 0
ORDER BY month;

-- Step 18: Check Both Growth Metrics
WITH monthly_metrics AS (
    SELECT
        DATE_FORMAT(order_timestamp, '%Y-%m') AS month,
        SUM(quantity * unit_selling_price - discount_amount) AS total_gmv,
        SUM(
            CASE
                WHEN order_status = 'Delivered'
                THEN (quantity * unit_selling_price - discount_amount)
                     - refund_amount
                     - payment_fee
                     - fulfilment_cost
                ELSE 0
            END
        ) AS contribution_proxy
    FROM marketplace_transactions
    GROUP BY DATE_FORMAT(order_timestamp, '%Y-%m')
),
growth_metrics AS (
    SELECT
        month,
        total_gmv,
