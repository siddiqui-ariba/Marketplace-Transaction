-- Step 19: Monthly GMV, Delivered GMV , Contribution Summary

SELECT
    DATE_FORMAT(order_timestamp, '%Y-%m') AS month,

    ROUND(
        SUM(quantity * unit_selling_price - discount_amount), 2
